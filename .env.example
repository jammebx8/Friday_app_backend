# ─── Copy this file to .env and fill in your values ──────────────────────────

# Groq Cloud API key — https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase project credentials — https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://orkzotrsgyfabeysqzjx.supabase.co
SUPABASE_KEY=sb_publishable_GjYC1ctm-MekB4jhlCXcig_d14gdDPb
# AI model identifiers (defaults shown — override if needed)
OPENAI_MODEL=openai/gpt-oss-120b
VISION_MODEL=qwen/qwen3-72b
EMBED_MODEL=BAAI/bge-small-en-v1.5

# RAG tuning
TOP_K_CHUNKS=5

# PDF processing
PDF_DPI=200
OCR_BATCH_SIZE=5
OCR_MAX_RETRIES=3
OCR_RETRY_BASE_DELAY=1.5

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=info

# CORS — comma-separated list of allowed origins (use * for development only)
CORS_ORIGINS=["http://localhost:3000","https://friday-ai-topaz-ten.vercel.app/"]

# Temporary directory for rendered PDF images
TMP_DIR=/tmp/friday_rag
